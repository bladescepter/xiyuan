---
import { useTranslations } from "@/i18n";
const t = useTranslations(Astro.currentLocale);
---

<div
  id="btt-btn-container"
  class="fixed bottom-8 right-4 z-50 pointer-events-none opacity-0 translate-y-4 transition-all duration-300"
  inert
>
  <button
    data-button="back-to-top"
    class="flex size-10 items-center justify-center rounded-full bg-gray-400/60 text-white shadow-lg backdrop-blur-sm hover:bg-gray-400/80 transition-colors"
    type="button"
    aria-label={t.post.backToTop}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-5"
    >
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>
</div>

<script>
  let controller: AbortController | undefined;

  function cleanupBackToTop() {
    controller?.abort();
    controller = undefined;
  }

  function initBackToTop() {
    cleanupBackToTop();

    const root = document.documentElement;
    const container = document.querySelector<HTMLElement>("#btt-btn-container");
    const btn = container?.querySelector<HTMLButtonElement>(
      "[data-button='back-to-top']"
    );
    if (!container || !btn) return;

    controller = new AbortController();
    const { signal } = controller;

    btn.addEventListener(
      "click",
      () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      },
      { signal }
    );

    function updateVisibility() {
      if (!container) return;
      const scrollTotal = root.scrollHeight - root.clientHeight;
      const isVisible = scrollTotal > 0 && root.scrollTop / scrollTotal > 0.3;

      container.inert = !isVisible;
      container.classList.toggle("pointer-events-none", !isVisible);
      container.classList.toggle("opacity-0", !isVisible);
      container.classList.toggle("translate-y-4", !isVisible);
      container.classList.toggle("opacity-100", isVisible);
      container.classList.toggle("translate-y-0", isVisible);
    }

    document.addEventListener("scroll", updateVisibility, {
      passive: true,
      signal,
    });
    window.addEventListener("resize", updateVisibility, {
      passive: true,
      signal,
    });
    updateVisibility();
  }

  document.addEventListener("astro:before-swap", cleanupBackToTop);
  document.addEventListener("astro:page-load", initBackToTop);
</script>
