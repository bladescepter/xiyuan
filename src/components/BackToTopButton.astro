---
import { useTranslations } from "@/i18n";
const t = useTranslations(Astro.currentLocale);
---

<div
  id="btt-btn-container"
  class="fixed bottom-8 right-4 z-50 opacity-0 translate-y-4 transition-all duration-300"
>
  <button
    data-button="back-to-top"
    class="flex size-10 items-center justify-center rounded-full bg-gray-400/60 text-white shadow-lg backdrop-blur-sm hover:bg-gray-400/80 transition-colors"
    aria-label="回到顶部"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-5">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>
</div>

<script is:inline data-astro-rerun>
  function initBackToTop() {
    const root = document.documentElement;
    const container = document.querySelector("#btt-btn-container");
    const btn = document.querySelector("[data-button='back-to-top']");
    if (!container || !btn) return;

    btn.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });

    let lastVisible = false;
    document.addEventListener("scroll", () => {
      const scrollTotal = root.scrollHeight - root.clientHeight;
      const scrollTop = root.scrollTop;
      const isVisible = scrollTop / scrollTotal > 0.3;

      if (isVisible !== lastVisible) {
        container.classList.toggle("opacity-0", !isVisible);
        container.classList.toggle("translate-y-4", !isVisible);
        container.classList.toggle("opacity-100", isVisible);
        container.classList.toggle("translate-y-0", isVisible);
        lastVisible = isVisible;
      }
    });
  }
  initBackToTop();
</script>
